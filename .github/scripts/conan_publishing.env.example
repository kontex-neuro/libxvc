# Conan publishing configuration.
#
# Copy this file to conan_publishing.env, fill in every value, then run:
#
#   python .github/scripts/configure_conan_publishing.py \
#       --repo kontex-neuro/libxvc --config .github/scripts/conan_publishing.env --dry-run
#   python .github/scripts/configure_conan_publishing.py \
#       --repo kontex-neuro/libxvc --config .github/scripts/conan_publishing.env
#
# conan_publishing.env is gitignored. It contains live credentials: never commit
# it, and delete it once the repository is configured.
#
# Format: KEY=VALUE, one per line. Blank lines and # comments are ignored.
# Values are taken literally; do not quote them unless the quotes are part of
# the value. Surrounding whitespace is stripped.

# --- Secrets (stored as GitHub Actions secrets) ---------------------------

# Cloudflare R2 API token access key ID. EXACTLY 32 hex characters.
# Cloudflare dashboard -> R2 -> Manage API Tokens -> Create API Token,
# permission "Object Read & Write", scoped to the bucket below.
# The token screen shows three values. Use "Access Key ID" here, NOT the
# longer "Token value" -- mixing them up fails mid-release with
# "Credential access key has length N, should be 32".
KONTEX_R2_ACCESS_KEY_ID=

# Cloudflare R2 API token secret access key. EXACTLY 64 characters.
# Shown only once at creation; roll the token if you no longer have it.
KONTEX_R2_SECRET_ACCESS_KEY=

# GitHub personal access token allowed to push to the recipe index repository.
#
# Fine-grained tokens need ALL THREE of the following, and the third is the
# one that is easy to miss:
#   1. Resource owner: the organization (not your personal account)
#   2. Repository access: the recipe index repository
#   3. Repository permissions -> Contents: Read and write
#      A new fine-grained token has NO permissions until you add them.
#      Repository access alone grants nothing.
#
# If the organization requires approval, the token also has to be approved at
#   github.com/organizations/<org>/settings/personal-access-tokens
# An unapproved or permission-less token still reads fine, so checkout
# succeeds and only the final push fails with 403.
#
# Classic tokens: "repo" scope, and authorize for the org via SSO if enabled.
KONTEX_CONAN_PAT=

# --- Variables (stored as GitHub Actions variables, not secret) -----------

# Cloudflare account ID, shown on the R2 overview page.
KONTEX_R2_ACCOUNT_ID=

# R2 bucket holding the published archives.
KONTEX_R2_BUCKET=kontex-conan

# Public base URL for the bucket. No trailing slash.
# Either the r2.dev subdomain (https://pub-<hash>.r2.dev) or a custom domain.
# Public access must be enabled on the bucket or release verification fails.
# This must match the value hardcoded in public_conan.py.
KONTEX_R2_PUBLIC_BASE_URL=https://dl-conan.kontex.io

# Key prefix inside the bucket. Archives are published to
# <KONTEX_R2_PUBLIC_BASE_URL>/<KONTEX_R2_PACKAGE_PREFIX>/<archive>.zip
KONTEX_R2_PACKAGE_PREFIX=libxvc

# owner/repo of the Conan recipe index receiving the source-free recipe.
KONTEX_CONAN_REPOSITORY=kontex-neuro/kontex-conan
